# Copy to .env and replace both secrets before starting Docker Compose.
DB_PASSWORD=replace_with_url_safe_database_password
JWT_SECRET=replace_with_random_secret_at_least_32_characters
HTTP_PORT=8080
POSTGRES_PORT=5432
ENVIRONMENT=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,frontend
